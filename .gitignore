# 依赖与构建产物
/node_modules
/.next/
/out/
/build/

# 环境变量（严禁入库：包含 API Key）
.env
.env.local
.env.*.local

# 测试与覆盖率
/coverage
*.log

# 系统文件
.DS_Store
Thumbs.db

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/

# 本地账单数据（隐私红线：任何时候都不得提交真实账单）
*.private.*
/data/private/

# 构建期从 samples/ 同步过来的样例副本（源头在 samples/，不入库两份）
/public/samples/

# TypeScript 增量编译缓存
*.tsbuildinfo

